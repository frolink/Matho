# ──────────────────────────────────────────────────────────────
# MATHO — Environment Variables (example)
# Copy to .env and fill in real values. Never commit .env.
# ──────────────────────────────────────────────────────────────

# ---- App ----
NODE_ENV=development
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
API_URL=http://localhost:4000

# ---- Database (PostgreSQL) ----
POSTGRES_USER=matho
POSTGRES_PASSWORD=matho_dev_password
POSTGRES_DB=matho_dev
DATABASE_URL=postgresql://matho:matho_dev_password@localhost:5432/matho_dev?schema=public

# ---- Cache (Redis) ----
REDIS_URL=redis://localhost:6379

# ---- Auth / JWT ----
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Pi Network SDK (placeholder credentials) ----
# See packages/sdk — auth uses only GET /v2/me with the user's own accessToken;
# PI_API_KEY is NOT required for authentication and is reserved for future
# payment operations only.
PI_API_KEY=pi_placeholder_api_key
PI_APP_ID=pi_placeholder_app_id
PI_SANDBOX=true
PI_API_BASE_URL=https://api.minepi.com/v2

# Public (browser-exposed) equivalents used by apps/web:
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PI_SANDBOX=true

# ---- Object Storage (S3-compatible) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=matho-media
S3_ACCESS_KEY_ID=placeholder
S3_SECRET_ACCESS_KEY=placeholder

# ---- Streaming provider (kept provider-agnostic, see packages/sdk/streaming) ----
STREAMING_PROVIDER=placeholder
STREAMING_API_KEY=placeholder

# ---- Observability ----
LOG_LEVEL=info

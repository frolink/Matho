{
  "name": "matho",
  "version": "0.1.0",
  "private": true,
  "description": "MATHO — One Live. Global Market. AI-powered global live social commerce platform for the Pi ecosystem.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@matho/web",
    "dev:admin": "turbo run dev --filter=@matho/admin",
    "dev:api": "turbo run dev --filter=@matho/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=@matho/web",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "npm run generate --workspace=@matho/database",
    "db:push": "npm run push --workspace=@matho/database",
    "db:migrate": "npm run migrate:dev --workspace=@matho/database",
    "db:migrate:deploy": "npm run migrate:deploy --workspace=@matho/database",
    "db:studio": "npm run studio --workspace=@matho/database",
    "db:seed": "npm run seed --workspace=@matho/database",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "eslint": "^9.11.1",
    "@eslint/js": "^9.11.1",
    "typescript-eslint": "^8.7.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "typescript": "^5.6.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,md,css}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "@prisma/client@5.19.1": true,
    "@prisma/engines@5.19.1": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "prisma@5.19.1": true,
    "unrs-resolver@1.12.2": true
  }
}
